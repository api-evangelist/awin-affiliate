  "info": {
    "_postman_id": "1c576019-11c8-4be9-8ef2-4ecd726f2c82",
    "name": "Awin Accounts Commission Groups API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Documented public REST API for the Awin global affiliate marketing network. Publishers and advertisers pull individual transactions and aggregated performance reports, read commission groups and programme details, and list the accounts a user can access. All endpoints are served over HTTPS only, return JSON, and authenticate with an OAuth 2.0 Bearer access token issued at the user level from the Awin UI. A platform throttle limits usage to 20 API calls per minute per user. Endpoints and parameters below are grounded in the public Awin API documentation at help.awin.com/apidocs.\n\nContact Support:\n Name: Awin API Support",
      "type": "text/plain"
    }
  }
