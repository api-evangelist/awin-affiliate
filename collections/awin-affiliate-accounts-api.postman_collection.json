                  "disabled": false,
                  "key": "accessToken",
                  "value": "<string>",
                  "description": "(Required) User-level access token (also accepted as an Authorization Bearer header)."
                },
                {
                  "disabled": false,
                  "key": "type",
                  "value": "<string>",
                  "description": "Filter by account type."
                }
              ],
              "variable": []
            },
