          "request": {
            "name": "Get accounts for the authenticated user",
            "description": {
              "content": "Return the list of accounts associated with the user. Because tokens are user-level, this enumerates every publisher and advertiser account the user can access.",
              "type": "text/plain"
            },
            "url": {
